import platformdirs
import tomllib

wee__remote_pool = []

WEE__SEV_DEVICE = "/dev/sev"
WEE__SEV_PARAMS = "/sys/module/kvm_amd/parameters"
WEE__SEV_LEAF = 0x8000001F
WEE__SEV_POLICY_ES = 0x4
WEE__SEV_KINDS = {
    "sev": ("sev-guest", 2, "sev"),
    "es": ("sev-guest", 3, "sev_es"),
    "snp": ("sev-snp-guest", 4, "sev_snp"),
}
WEE__KVM_CHECK_EXTENSION = 0xAE03
WEE__KVM_CAP_VM_TYPES = 235
WEE__LIST_WIDTH = 64


def wee__info(text):
    print("info: " + text, file=sys.stderr)


def wee__near(name, names):
    near = difflib.get_close_matches(name, list(names), 3)
    if not near:
        return ""

    return ", did you mean " + ", ".join(near) + "?"


def wee__remote_stow(path):
    wee__info("fetching " + path)
    path, _ = urllib.request.urlretrieve(path)
    wee__remote_pool.append(path)
    return path


def wee__remote_drop(path):
    wee__info("removing " + path)
    pathlib.Path(path).unlink()


def wee__remote_wipe():
    any(wee__remote_drop(path) for path in wee__remote_pool)
    wee__remote_pool.clear()


def wee__remote_link(path):
    return urllib.parse.urlparse(path).scheme in ("http", "https")


def wee__remote_path(path):
    if wee__remote_link(path):
        path = wee__remote_stow(path)

    return path


def wee__cpuid(leaf):
    code = bytes.fromhex(
        "53" "89f8" "31c9" "0fa2" "8906" "895e04" "894e08" "89560c" "5b" "c3"
    )

    page = mmap.mmap(
        -1, len(code), prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC
    )
    page.write(code)

    view = ctypes.c_char.from_buffer(page)
    call = ctypes.CFUNCTYPE(
        None, ctypes.c_uint32, ctypes.POINTER(ctypes.c_uint32)
    )(ctypes.addressof(view))

    regs = (ctypes.c_uint32 * 4)()
    call(leaf, regs)
    vals = tuple(regs)

    del call, view
    page.close()

    return vals


def wee__sev_bits():
    try:
        ebx = wee__cpuid(WEE__SEV_LEAF)[1]
    except Exception:
        return None

    return ebx & 0x3F, (ebx >> 6) & 0x3F


def wee__sev_types():
    try:
        node = os.open("/dev/kvm", os.O_RDWR | os.O_CLOEXEC)
    except OSError:
        return None

    try:
        return fcntl.ioctl(
            node, WEE__KVM_CHECK_EXTENSION, WEE__KVM_CAP_VM_TYPES
        )
    except OSError:
        return None
    finally:
        os.close(node)


def wee__sev_why(knob):
    file = pathlib.Path(WEE__SEV_PARAMS) / knob
    if not file.exists():
        return "'kvm_amd' has no SEV support"
    if file.read_text().strip() != "Y":
        return "'kvm_amd." + knob + "' is not enabled"

    return "KVM does not offer the VM type"


def wee__qmp(qemu, cmds):
    comm = [str(qemu), "-machine", "none", "-display", "none", "-qmp", "stdio"]
    send = [{"execute": "qmp_capabilities"}] + cmds + [{"execute": "quit"}]

    try:
        done = subprocess.run(
            comm,
            input="\n".join(json.dumps(item) for item in send),
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return []

    outs = []
    for line in done.stdout.splitlines():
        try:
            data = json.loads(line)
        except json.JSONDecodeError:
            continue

        if "return" in data.keys() or "error" in data.keys():
            outs.append(data)

    return outs[1:]


def wee__cpu_fail(kind, name, names, qemu):
    sys.exit(
        "error: bad config, '"
        + name
        + "' is not a CPU "
        + kind
        + " in '"
        + str(qemu)
        + "'"
        + wee__near(name, names)
    )


def wee__cpu_setup(spec):
    model = spec["cpu"]["model"]
    args = {"type": "full", "model": {"name": model}}
    outs = wee__qmp(
        spec["qemu"],
        [
            {"execute": "query-cpu-model-expansion", "arguments": args},
            {"execute": "query-cpu-definitions"},
        ],
    )

    if len(outs) < 2:
        wee__info("unable to query CPU models, skipping check")
        return

    if "error" in outs[0].keys():
        names = [item["name"] for item in outs[1].get("return", [])]
        wee__cpu_fail("model", model, names, spec["qemu"])

    props = outs[0]["return"]["model"]["props"]

    for flag in spec["cpu"]["flags"]:
        name = flag.lstrip("+-").split("=")[0].replace("_", "-")
        if not name in props.keys():
            wee__cpu_fail("flag", name, props.keys(), spec["qemu"])


def wee__sev_setup(spec):
    name = spec["sev"]["type"]
    kind, kvmt_bit, knob = WEE__SEV_KINDS[name]

    kvmt = wee__sev_types()
    if kvmt is None:
        wee__info("'/dev/kvm' not readable, skipping capability check")
    elif not kvmt & (1 << kvmt_bit):
        sys.exit(
            "error: host cannot run '"
            + name
            + "' guests, "
            + wee__sev_why(knob)
        )

    if not pathlib.Path(WEE__SEV_DEVICE).exists():
        sys.exit(
            "error: '"
            + WEE__SEV_DEVICE
            + "' not found, memory encryption not enabled by BIOS"
        )

    bits = wee__sev_bits()
    if not bits:
        sys.exit("error: unable to read SEV parameters from CPUID")

    props = {"cbitpos": bits[0], "reduced-phys-bits": bits[1]}
    if name == "es":
        props["policy"] = 0x1 | WEE__SEV_POLICY_ES

    wee__info(
        name
        + " guest, cbitpos="
        + str(props["cbitpos"])
        + ", reduced-phys-bits="
        + str(props["reduced-phys-bits"])
    )

    spec["sev"]["kind"] = kind
    spec["sev"]["props"] = {
        key: hex(val) if key == "policy" else str(val)
        for key, val in props.items()
    }


def wee__sev_args(spec):
    if spec["sev"]["type"] == "none":
        return []

    opts = ["id=sev0"] + [
        key + "=" + val for key, val in spec["sev"]["props"].items()
    ]

    return [
        "-object",
        spec["sev"]["kind"] + "," + ",".join(opts),
        "-machine",
        "confidential-guest-support=sev0",
    ]


def wee__config_load():
    file = platformdirs.user_config_path("wee") / "guests.toml"
    file.parent.mkdir(parents=True, exist_ok=True)
    if not file.exists():
        file.touch()

    return tomllib.loads(file.read_text())


def wee__merge(base, over):
    for key, val in over.items():
        if isinstance(base.get(key), dict) and isinstance(val, dict):
            wee__merge(base[key], val)
        else:
            base[key] = val


def wee__config_flat(table, pre=""):
    opts = []
    for key, val in table.items():
        if isinstance(val, dict):
            opts += wee__config_flat(val, pre + key + ".")
        else:
            opts.append((pre + key, val))

    return opts


def wee__config_show(val):
    if isinstance(val, bool):
        return "true" if val else "false"
    if isinstance(val, str):
        return '"' + val + '"'
    if isinstance(val, list):
        return "[ " + ", ".join(wee__config_show(item) for item in val) + " ]"

    return str(val)


def wee__config_list():
    for guest in wee__config_load().keys():
        print(guest)

    return 0


def wee__config_mods(name):
    data = wee__config_load()
    if not name in data.keys():
        sys.exit(
            "error: guest '" + name + "' not found" + wee__near(name, data)
        )

    for mod, opts in data[name].get("mods", {}).items():
        print(mod)
        for key, val in wee__config_flat(opts):
            text = key + " = " + wee__config_show(val)
            if len(text) > WEE__LIST_WIDTH:
                text = text[:WEE__LIST_WIDTH] + "..."

            print("    " + text)

    return 0


def wee__config_image(spec, key, show):
    if not isinstance(spec[key], str):
        sys.exit("error: bad config, '" + key + "' is not valid")

    if show and wee__remote_link(spec[key]):
        return

    path = pathlib.Path(wee__remote_path(spec[key])).expanduser().resolve()
    if not path.exists() or not path.is_file():
        sys.exit("error: bad config, '" + key + "' is not valid")

    spec[key] = path


def wee__config_read(name, mods=None, show=False):
    data = wee__config_load()
    spec = next((data[key] for key in data.keys() if key == name), None)
    if not spec:
        sys.exit(
            "error: guest '" + name + "' not found" + wee__near(name, data)
        )

    if not "mods" in spec.keys():
        spec["mods"] = {}

    if mods:
        for mod in mods:
            if not mod in spec["mods"].keys():
                sys.exit(
                    "error: mod '"
                    + mod
                    + "' not found in '"
                    + name
                    + "'"
                    + wee__near(mod, spec["mods"])
                )

        for mod in mods:
            wee__merge(spec, copy.deepcopy(spec["mods"][mod]))

    if not "cpu" in spec.keys():
        spec["cpu"] = {}

    if not "model" in spec["cpu"].keys():
        spec["cpu"]["model"] = "host"
    elif not isinstance(spec["cpu"]["model"], str):
        sys.exit("error: bad config, 'cpu.model' is not valid")

    if not "flags" in spec["cpu"].keys():
        spec["cpu"]["flags"] = []
    elif not isinstance(spec["cpu"]["flags"], list) or any(
        not isinstance(flag, str) for flag in spec["cpu"]["flags"]
    ):
        sys.exit("error: bad config, 'cpu.flags' is not valid")

    if not "smp" in spec.keys():
        sys.exit("error: bad config, 'smp' is not set")
    elif not isinstance(spec["smp"], int):
        sys.exit("error: bad config, 'smp' is not valid")

    if not "mem" in spec.keys():
        sys.exit("error: bad config, 'mem' is not set")
    if not "size" in spec["mem"].keys():
        sys.exit("error: bad config, 'mem.size' is not set")
    elif not isinstance(spec["mem"]["size"], int):
        sys.exit("error: bad config, 'mem.size' is not valid")
    if not "unit" in spec["mem"].keys():
        spec["mem"]["unit"] = "G"
    elif not spec["mem"]["unit"] in ("M", "G"):
        sys.exit("error: bad config, 'mem.unit' is not valid")

    if not "disk" in spec.keys():
        sys.exit("error: bad config, 'disk' is not set")
    elif not isinstance(spec["disk"], str):
        sys.exit("error: bad config, 'disk' is not valid")

    spec["disk"] = pathlib.Path(spec["disk"]).expanduser().resolve()
    if not spec["disk"].exists() or not spec["disk"].is_file():
        sys.exit("error: bad config, 'disk' is not valid")

    if "bios" in spec.keys():
        if not isinstance(spec["bios"], str):
            sys.exit("error: bad config, 'bios' is not valid")

        spec["bios"] = pathlib.Path(spec["bios"]).expanduser().resolve()
        if not spec["bios"].exists() or not spec["bios"].is_file():
            sys.exit("error: bad config, 'bios' is not valid")

    if "kernel" in spec.keys():
        wee__config_image(spec, "kernel", show)

    if "initrd" in spec.keys():
        wee__config_image(spec, "initrd", show)

    if "append" in spec.keys():
        if not isinstance(spec["append"], str):
            sys.exit("error: bad config, 'append' is not valid")

    if not "qemu" in spec.keys():
        spec["qemu"] = shutil.which("qemu-system-x86_64")
    elif not isinstance(spec["qemu"], str):
        sys.exit("error: bad config, 'qemu' is not valid")

    if not spec["qemu"]:
        sys.exit("error: bad config, 'qemu' is not set")

    spec["qemu"] = pathlib.Path(spec["qemu"]).expanduser().resolve()
    if not spec["qemu"].exists() or not spec["qemu"].is_file():
        sys.exit("error: bad config, 'qemu' is not valid")

    wee__cpu_setup(spec)

    if not "sev" in spec.keys():
        spec["sev"] = {}
    elif not isinstance(spec["sev"], dict):
        sys.exit("error: bad config, 'sev' is not valid")

    if not "type" in spec["sev"].keys():
        spec["sev"]["type"] = "none"
    elif not spec["sev"]["type"] in ("none",) + tuple(WEE__SEV_KINDS.keys()):
        sys.exit("error: bad config, 'sev.type' is not valid")

    if spec["sev"]["type"] != "none":
        wee__sev_setup(spec)

    if not "sudo" in spec.keys():
        spec["sudo"] = spec["sev"]["type"] != "none"
    elif not isinstance(spec["sudo"], bool):
        sys.exit("error: bad config, 'sudo' is not valid")

    if not "extras" in spec.keys():
        spec["extras"] = []
    elif not isinstance(spec["extras"], list) or any(
        not isinstance(option, str) for option in spec["extras"]
    ):
        sys.exit("error: bad config, 'extras' is not valid")

    return spec


def wee__launch(name, mods, show=False):
    spec = wee__config_read(name, mods, show)
    if not spec:
        return 1

    comm = [
        str(spec["qemu"]),
        "-enable-kvm",
        "-cpu",
        ",".join([spec["cpu"]["model"]] + spec["cpu"]["flags"]),
        "-smp",
        str(spec["smp"]),
        "-m",
        str(spec["mem"]["size"]) + spec["mem"]["unit"],
    ]

    if spec["sudo"]:
        comm.insert(0, "sudo")
    if "bios" in spec.keys():
        comm.extend(["-bios", str(spec["bios"])])
    if "kernel" in spec.keys():
        comm.extend(["-kernel", str(spec["kernel"])])
    if "initrd" in spec.keys():
        comm.extend(["-initrd", str(spec["initrd"])])
    if "append" in spec.keys():
        comm.extend(["-append", spec["append"]])

    comm.extend(wee__sev_args(spec))

    if "extras" in spec.keys():
        comm.extend(spec["extras"])

    comm.extend(
        [
            "-drive",
            "file=" + str(spec["disk"]) + ",if=none,id=disk",
            "-device",
            "virtio-blk-pci,drive=disk",
            "-net",
            "nic,model=virtio",
            "-net",
            "user",
            "-nographic",
            "-serial",
            "mon:stdio",
        ]
    )

    if show:
        print(shlex.join(comm))
        return 0

    with subprocess.Popen(comm, shell=False) as process:
        return process.wait()


def main() -> int:
    atexit.register(wee__remote_wipe)

    parser = argparse.ArgumentParser(
        description="Launch basic x86-64 KVM guests."
    )
    subs = parser.add_subparsers(dest="command", metavar="COMMAND")

    subs.add_parser("list", help="list guests")

    mods = subs.add_parser("mods", help="list mods of a guest")
    mods.add_argument("name", metavar="GUEST", type=str, help="guest name")

    boot = subs.add_parser("exec", help="start a guest")
    boot.add_argument(
        "--mods", "-m", metavar="LIST", type=str, help="guest mods"
    )
    boot.add_argument(
        "--comm", "-c", action="store_true", help="show command line"
    )
    boot.add_argument("name", metavar="GUEST", type=str, help="guest name")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 0

    if args.command == "list":
        return wee__config_list()

    if args.command == "mods":
        return wee__config_mods(args.name)

    if args.mods:
        args.mods = [mod.strip() for mod in args.mods.split(",")]

    return wee__launch(args.name, args.mods if args.mods else None, args.comm)


if __name__ == "__main__":
    sys.exit(main())
