import platformdirs

wee__remote_pool = []

wee__props = types.SimpleNamespace(
    sev=types.SimpleNamespace(
        device="/dev/sev",
        leaf=0x8000001F,
        policy_es=0x4,
        policy_mbo=0x20000,
        protected=("es", "snp"),
        types={
            "sev": types.SimpleNamespace(
                object="sev-guest",
                vm=2,
            ),
            "es": types.SimpleNamespace(
                object="sev-guest",
                vm=3,
            ),
            "snp": types.SimpleNamespace(
                object="sev-snp-guest",
                vm=4,
            ),
        },
    ),
    kvm=types.SimpleNamespace(check_extension=0xAE03, cap_vm_types=235),
    mods=types.SimpleNamespace(width=64),
    edit=types.SimpleNamespace(editors=("editor", "vi")),
    dev=types.SimpleNamespace(
        blk={
            "virtio": "virtio-blk-pci,drive=disk",
            "ahci": "ide-hd,drive=disk,bus=ide.0",
        },
        net={
            "virtio": "nic,model=virtio",
            "e1000e": "nic,model=e1000e",
        },
    ),
    conn=types.SimpleNamespace(
        host="127.0.0.1",
        ports={
            "vnc": types.SimpleNamespace(default=5900, minimum=5900),
            "ssh": types.SimpleNamespace(default=2222, minimum=1),
        },
        vnc_base=5900,
    ),
)


def wee__info(text):
    """Report progress without disturbing the command output."""
    print("info: " + text, file=sys.stderr)


def wee__near(name, names):
    """Suggest the closest valid spelling of a mistyped name."""
    near = difflib.get_close_matches(name, list(names), 1)
    if not near:
        return ""

    return ", did you mean '" + near[0] + "'?"


def wee__remote_stow(path):
    """Fetch a remote image into temporary storage for this run."""
    wee__info("fetching " + path)
    path, _ = urllib.request.urlretrieve(path)
    wee__remote_pool.append(path)
    return path


def wee__remote_drop(path):
    """Discard one temporary image."""
    wee__info("removing " + path)
    pathlib.Path(path).unlink()


def wee__remote_wipe():
    """Discard every temporary image kept for this run."""
    any(wee__remote_drop(path) for path in wee__remote_pool)
    wee__remote_pool.clear()


def wee__remote_link(path):
    """Tell whether a location has to be fetched over the network."""
    return urllib.parse.urlparse(path).scheme in ("http", "https")


def wee__remote_path(path):
    """Resolve a location to something locally readable."""
    if wee__remote_link(path):
        path = wee__remote_stow(path)

    return path


def wee__cpuid(leaf):
    """Read one processor information leaf."""
    code = bytes.fromhex("53 89f8 31c9 0fa2 8906 895e04 894e08 89560c 5b c3")

    page = mmap.mmap(
        -1, len(code), prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC
    )
    page.write(code)

    view = ctypes.c_char.from_buffer(page)
    call = ctypes.CFUNCTYPE(
        None, ctypes.c_uint32, ctypes.POINTER(ctypes.c_uint32)
    )(ctypes.addressof(view))

    regs = (ctypes.c_uint32 * 4)()
    call(leaf, regs)
    vals = tuple(regs)

    del call, view
    page.close()

    return vals


def wee__sev_bits():
    """Report the encryption bit and the address bits it costs."""
    try:
        ebx = wee__cpuid(wee__props.sev.leaf)[1]
    except (OSError, ValueError):
        return None

    return ebx & 0x3F, (ebx >> 6) & 0x3F


def wee__sev_types():
    """Report which confidential guest types the host offers."""
    try:
        node = os.open("/dev/kvm", os.O_RDWR | os.O_CLOEXEC)
    except OSError:
        return None

    try:
        return fcntl.ioctl(
            node, wee__props.kvm.check_extension, wee__props.kvm.cap_vm_types
        )
    except OSError:
        return None
    finally:
        os.close(node)


def wee__qmp(qemu, cmds):
    """Ask a QEMU build a set of questions and collect the answers."""
    comm = [str(qemu), "-machine", "none", "-display", "none", "-qmp", "stdio"]
    send = [{"execute": "qmp_capabilities"}] + cmds + [{"execute": "quit"}]

    try:
        done = subprocess.run(
            comm,
            input="\n".join(json.dumps(item) for item in send),
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []

    outs = []
    for line in done.stdout.splitlines():
        try:
            data = json.loads(line)
        except json.JSONDecodeError:
            continue

        if "return" in data or "error" in data:
            outs.append(data)

    return outs[1:]


def wee__qom_props(qemu, obj):
    """Report the properties a QEMU build accepts for an object."""
    args = {"typename": obj}
    cmds = [{"execute": "qom-list-properties", "arguments": args}]
    outs = wee__qmp(qemu, cmds)
    if not outs or not isinstance(outs[0].get("return"), list):
        return None

    return {item["name"]: item["type"] for item in outs[0]["return"]}


def wee__cpu_fail(what, name, names):
    """Reject an unknown processor setting and suggest alternatives."""
    sys.exit(
        "error: config: '"
        + name
        + "' not a cpu "
        + what
        + wee__near(name, names)
    )


def wee__cpu_setup(spec):
    """Check the requested processor settings against the build."""
    model = spec["cpu"]["model"]
    args = {"type": "full", "model": {"name": model}}
    outs = wee__qmp(
        spec["qemu"],
        [
            {"execute": "query-cpu-model-expansion", "arguments": args},
            {"execute": "query-cpu-definitions"},
        ],
    )

    if len(outs) < 2:
        wee__info("unable to query CPU models, skipping check")
        return

    if "error" in outs[0]:
        names = [item["name"] for item in outs[1].get("return", [])]
        wee__cpu_fail("model", model, names)

    props = outs[0]["return"]["model"]["props"]

    for flag in spec["cpu"]["flags"]:
        name = flag.lstrip("+-").split("=")[0].replace("_", "-")
        if name not in props:
            wee__cpu_fail("flag", name, props)


def wee__sev_value(name, prop_type, value):
    """Render one property value the way QEMU expects to read it."""
    if prop_type == "OnOffAuto":
        if isinstance(value, bool):
            return "on" if value else "off"
        if value in ("on", "off", "auto"):
            return value
    elif isinstance(value, bool):
        return "true" if value else "false"
    elif isinstance(value, int):
        return hex(value) if name == "policy" else str(value)
    elif isinstance(value, str):
        return value.replace(",", ",,")

    sys.exit("error: config: 'sev.props." + name + "' not valid")


def wee__sev_check(name, sev_type):
    """Refuse a confidential guest the host is unable to run."""
    kvmt = wee__sev_types()
    if kvmt is None:
        wee__info("'/dev/kvm' not readable, skipping capability check")
    elif not kvmt & (1 << sev_type.vm):
        sys.exit("error: host: '" + name + "' guests not supported by kvm")

    if not pathlib.Path(wee__props.sev.device).exists():
        sys.exit("error: host: memory encryption not enabled")


def wee__sev_policy(name, props):
    """Check the requested policy and add what the type implies."""
    policy = props.get("policy")
    if policy is not None and (
        isinstance(policy, bool) or not isinstance(policy, int)
    ):
        sys.exit("error: config: 'sev.props.policy' not valid")

    if name == "es":
        props["policy"] = (policy or 0x1) | wee__props.sev.policy_es
    elif name == "sev" and policy and policy & wee__props.sev.policy_es:
        sys.exit(
            "error: config: 'sev.props.policy' selects sev-es, "
            + "use 'sev.type = \"es\"'"
        )
    elif name == "snp" and policy and not policy & wee__props.sev.policy_mbo:
        sys.exit("error: config: 'sev.props.policy' must set bit 17")


def wee__sev_limits(spec):
    """Refuse what a guest with protected state cannot be given."""
    name = spec["sev"]["type"]
    if name not in wee__props.sev.protected:
        return

    if isinstance(spec.get("bios"), dict):
        sys.exit(
            "error: config: '" + name + "' guests need a single 'bios' image"
        )


def wee__sev_setup(spec):
    """Prepare and check the settings of a confidential guest."""
    name = spec["sev"]["type"]
    sev_type = wee__props.sev.types[name]
    props = spec["sev"]["props"]

    wee__sev_check(name, sev_type)

    bits = wee__sev_bits()
    if bits:
        props.setdefault("cbitpos", bits[0])
        props.setdefault("reduced-phys-bits", bits[1])

    for key in ("cbitpos", "reduced-phys-bits"):
        if key not in props:
            sys.exit("error: config: 'sev.props." + key + "' not set")

    wee__sev_policy(name, props)

    prop_types = wee__qom_props(spec["qemu"], sev_type.object)
    if not prop_types:
        sys.exit(
            "error: host: '"
            + sev_type.object
            + "' properties not listed by qemu"
        )

    for key in props:
        if key not in prop_types:
            sys.exit(
                "error: config: 'sev.props."
                + key
                + "' unknown"
                + wee__near(key, prop_types)
            )

    wee__info(
        name
        + " guest, cbitpos="
        + str(props["cbitpos"])
        + ", reduced-phys-bits="
        + str(props["reduced-phys-bits"])
    )

    spec["sev"]["object"] = sev_type.object
    spec["sev"]["props"] = {
        key: wee__sev_value(key, prop_types[key], val)
        for key, val in props.items()
    }


def wee__args_sev(spec):
    """Build the options that make a guest a confidential one."""
    if spec["sev"]["type"] == "none":
        return []

    props = spec["sev"]["props"]
    order = ["cbitpos", "reduced-phys-bits"]
    order += [key for key in props if key not in order]

    opts = ["id=sev0"] + [key + "=" + props[key] for key in order]

    return [
        "-object",
        spec["sev"]["object"] + "," + ",".join(opts),
        "-machine",
        "confidential-guest-support=sev0",
    ]


def wee__args_conn_vnc(spec):
    """Build the options that give the guest a remote display."""
    conn = spec["conn"]
    if not conn["vnc"]:
        return ["-nographic"]

    port = conn["port"]["vnc"]
    wee__info("vnc on " + wee__props.conn.host + ":" + str(port))

    return [
        "-display",
        "none",
        "-vnc",
        wee__props.conn.host + ":" + str(port - wee__props.conn.vnc_base),
        "-device",
        "qemu-xhci",
        "-device",
        "usb-tablet",
    ]


def wee__args_conn_ssh(spec):
    """Build the network backend, forwarding a host port to the guest."""
    conn = spec["conn"]
    if not conn["ssh"]:
        return ["-net", "user"]

    port = str(conn["port"]["ssh"])
    wee__info("ssh on " + wee__props.conn.host + ":" + port)

    return [
        "-net",
        "user,hostfwd=tcp:" + wee__props.conn.host + ":" + port + "-:22",
    ]


def wee__args_bios(spec):
    """Build the options that load the guest's firmware."""
    if "bios" not in spec:
        return []

    bios = spec["bios"]
    if not isinstance(bios, dict):
        return ["-bios", str(bios)]

    return [
        "-drive",
        "if=pflash,format=raw,unit=0,readonly=on,file=" + str(bios["code"]),
        "-drive",
        "if=pflash,format=raw,unit=1,file=" + str(bios["vars"]),
    ]


def wee__args_dev_blk(spec):
    """Build the options that connect the disk to the guest."""
    if "blk" not in spec["dev"]:
        return ["-drive", "file=" + str(spec["disk"])]

    return [
        "-drive",
        "file=" + str(spec["disk"]) + ",if=none,id=disk",
        "-device",
        wee__props.dev.blk[spec["dev"]["blk"]],
    ]


def wee__args_dev_net(spec):
    """Build the options that give the guest its network card."""
    if "net" not in spec["dev"]:
        return ["-net", "nic"]

    return ["-net", wee__props.dev.net[spec["dev"]["net"]]]


def wee__config_file():
    """Locate the guest definitions, creating the file if absent."""
    file = platformdirs.user_config_path("wee") / "guests.toml"
    file.parent.mkdir(parents=True, exist_ok=True)
    if not file.exists():
        file.touch()

    return file


def wee__config_load():
    """Read the guest definitions."""
    return tomllib.loads(wee__config_file().read_text())


def wee__merge(base, over):
    """Overlay one set of options onto another, table by table."""
    for key, val in over.items():
        if isinstance(base.get(key), dict) and isinstance(val, dict):
            wee__merge(base[key], val)
        else:
            base[key] = val


def wee__config_flat(table, pre=""):
    """Flatten nested options into the dotted form used in the file."""
    opts = []
    for key, val in table.items():
        if isinstance(val, dict):
            opts += wee__config_flat(val, pre + key + ".")
        else:
            opts.append((pre + key, val))

    return opts


def wee__config_show(val):
    """Render one option value the way it is written in the file."""
    if isinstance(val, bool):
        return "true" if val else "false"
    if isinstance(val, str):
        return '"' + val + '"'
    if isinstance(val, list):
        return "[ " + ", ".join(wee__config_show(item) for item in val) + " ]"

    return str(val)


def wee__config_list():
    """Print the name of every defined guest."""
    for guest in wee__config_load():
        print(guest)

    return 0


def wee__config_mods(name):
    """Print the mods of a guest and the options each one overrides."""
    data = wee__config_load()
    if name not in data:
        sys.exit(
            "error: guest: '" + name + "' not found" + wee__near(name, data)
        )

    for mod, opts in data[name].get("mods", {}).items():
        print(mod)
        for key, val in wee__config_flat(opts):
            text = key + " = " + wee__config_show(val)
            if len(text) > wee__props.mods.width:
                text = text[: wee__props.mods.width] + "..."

            print("    " + text)

    return 0


def wee__config_edit():
    """Open the guest definitions in the preferred editor."""
    edit = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not edit:
        for name in wee__props.edit.editors:
            if shutil.which(name):
                edit = name
                break

    if not edit:
        sys.exit("error: host: no editor found")

    comm = shlex.split(edit) + [str(wee__config_file())]
    with subprocess.Popen(comm, shell=False) as process:
        return process.wait()


def wee__config_image(spec, key, show):
    """Locate and check one boot image."""
    if key not in spec:
        return

    if not isinstance(spec[key], str):
        sys.exit("error: config: '" + key + "' not valid")

    if show and wee__remote_link(spec[key]):
        return

    path = pathlib.Path(wee__remote_path(spec[key])).expanduser().resolve()
    if not path.exists() or not path.is_file():
        sys.exit("error: config: '" + key + "' not valid")

    spec[key] = path


def wee__opts_kernel(spec, show):
    """Locate and check the kernel the guest boots directly."""
    wee__config_image(spec, "kernel", show)


def wee__opts_initrd(spec, show):
    """Locate and check the initial ramdisk given to that kernel."""
    wee__config_image(spec, "initrd", show)


def wee__opts_mods(spec, mods):
    """Apply the selected overrides in the order they were given."""
    if "mods" not in spec:
        spec["mods"] = {}

    if not mods:
        return

    for mod in mods:
        if mod not in spec["mods"]:
            sys.exit(
                "error: mods: '"
                + mod
                + "' not found"
                + wee__near(mod, spec["mods"])
            )

    for mod in mods:
        wee__merge(spec, copy.deepcopy(spec["mods"][mod]))


def wee__opts_cpu(spec):
    """Settle the processor model and the flags applied to it."""
    if "cpu" not in spec:
        spec["cpu"] = {}

    if "model" not in spec["cpu"]:
        spec["cpu"]["model"] = "host"
    elif not isinstance(spec["cpu"]["model"], str):
        sys.exit("error: config: 'cpu.model' not valid")

    if "flags" not in spec["cpu"]:
        spec["cpu"]["flags"] = []
    elif not isinstance(spec["cpu"]["flags"], list) or any(
        not isinstance(flag, str) for flag in spec["cpu"]["flags"]
    ):
        sys.exit("error: config: 'cpu.flags' not valid")


def wee__opts_smp(spec):
    """Settle how many processors the guest is given."""
    if "smp" not in spec:
        sys.exit("error: config: 'smp' not set")
    if not isinstance(spec["smp"], int):
        sys.exit("error: config: 'smp' not valid")


def wee__opts_mem(spec):
    """Settle how much memory the guest is given."""
    if "mem" not in spec:
        sys.exit("error: config: 'mem' not set")

    if "size" not in spec["mem"]:
        sys.exit("error: config: 'mem.size' not set")
    if not isinstance(spec["mem"]["size"], int):
        sys.exit("error: config: 'mem.size' not valid")

    if "unit" not in spec["mem"]:
        spec["mem"]["unit"] = "G"
    elif spec["mem"]["unit"] not in ("M", "G"):
        sys.exit("error: config: 'mem.unit' not valid")


def wee__opts_disk(spec):
    """Locate and check the storage the guest boots from."""
    if "disk" not in spec:
        sys.exit("error: config: 'disk' not set")
    if not isinstance(spec["disk"], str):
        sys.exit("error: config: 'disk' not valid")

    spec["disk"] = pathlib.Path(spec["disk"]).expanduser().resolve()
    if not spec["disk"].exists() or not spec["disk"].is_file():
        sys.exit("error: config: 'disk' not valid")


def wee__config_path(value, key):
    """Locate one file named in the configuration and check it exists."""
    if not isinstance(value, str):
        sys.exit("error: config: '" + key + "' not valid")

    path = pathlib.Path(value).expanduser().resolve()
    if not path.exists() or not path.is_file():
        sys.exit("error: config: '" + key + "' not valid")

    return path


def wee__config_owned(path, key):
    """Refuse to let the guest write to something the user does not own."""
    if path.stat().st_uid != os.getuid():
        sys.exit("error: config: '" + key + "' not owned by you")


def wee__opts_dev_blk(spec):
    """Settle how the disk is connected to the guest."""
    if "blk" not in spec["dev"]:
        return

    blk = spec["dev"]["blk"]
    if not isinstance(blk, str) or blk not in wee__props.dev.blk:
        sys.exit(
            "error: config: 'dev.blk' not valid"
            + wee__near(str(blk), wee__props.dev.blk)
        )


def wee__opts_dev_net(spec):
    """Settle the network card the guest is given."""
    if "net" not in spec["dev"]:
        return

    net = spec["dev"]["net"]
    if not isinstance(net, str) or net not in wee__props.dev.net:
        sys.exit(
            "error: config: 'dev.net' not valid"
            + wee__near(str(net), wee__props.dev.net)
        )


def wee__opts_dev(spec):
    """Settle the models of the devices the guest is given."""
    if "dev" not in spec:
        spec["dev"] = {}
    elif not isinstance(spec["dev"], dict):
        sys.exit("error: config: 'dev' not valid")

    wee__config_keys(spec["dev"], "dev", tuple(vars(wee__props.dev)))
    wee__opts_dev_blk(spec)
    wee__opts_dev_net(spec)


def wee__opts_bios_code(spec):
    """Locate and check the read-only half of split firmware."""
    if "code" not in spec["bios"]:
        sys.exit("error: config: 'bios.code' not set")

    spec["bios"]["code"] = wee__config_path(spec["bios"]["code"], "bios.code")


def wee__opts_bios_vars(spec):
    """Locate and check the guest's own store of firmware variables."""
    if "vars" not in spec["bios"]:
        sys.exit("error: config: 'bios.vars' not set")

    spec["bios"]["vars"] = wee__config_path(spec["bios"]["vars"], "bios.vars")
    wee__config_owned(spec["bios"]["vars"], "bios.vars")


def wee__opts_bios(spec):
    """Locate and check the firmware the guest starts from."""
    if "bios" not in spec:
        return

    if not isinstance(spec["bios"], dict):
        spec["bios"] = wee__config_path(spec["bios"], "bios")
        return

    wee__config_keys(spec["bios"], "bios", ("code", "vars"))
    wee__opts_bios_code(spec)
    wee__opts_bios_vars(spec)


def wee__opts_append(spec):
    """Check the command line handed to the guest kernel."""
    if "append" in spec and not isinstance(spec["append"], str):
        sys.exit("error: config: 'append' not valid")


def wee__opts_qemu(spec):
    """Locate and check the emulator the guest runs under."""
    if "qemu" not in spec:
        spec["qemu"] = shutil.which("qemu-system-x86_64")
    elif not isinstance(spec["qemu"], str):
        sys.exit("error: config: 'qemu' not valid")

    if not spec["qemu"]:
        sys.exit("error: config: 'qemu' not set")

    spec["qemu"] = pathlib.Path(spec["qemu"]).expanduser().resolve()
    if not spec["qemu"].exists() or not spec["qemu"].is_file():
        sys.exit("error: config: 'qemu' not valid")


def wee__opts_sev(spec):
    """Settle whether the guest is confidential and how."""
    if "sev" not in spec:
        spec["sev"] = {}
    elif not isinstance(spec["sev"], dict):
        sys.exit("error: config: 'sev' not valid")

    if "type" not in spec["sev"]:
        spec["sev"]["type"] = "none"
    elif spec["sev"]["type"] not in ("none",) + tuple(wee__props.sev.types):
        sys.exit("error: config: 'sev.type' not valid")

    if "props" not in spec["sev"]:
        spec["sev"]["props"] = {}
    elif not isinstance(spec["sev"]["props"], dict):
        sys.exit("error: config: 'sev.props' not valid")

    if spec["sev"]["type"] != "none":
        wee__sev_limits(spec)
        wee__sev_setup(spec)


def wee__opts_sudo(spec):
    """Settle whether the guest needs superuser privileges."""
    if "sudo" not in spec:
        spec["sudo"] = spec["sev"]["type"] != "none"
    elif not isinstance(spec["sudo"], bool):
        sys.exit("error: config: 'sudo' not valid")


def wee__opts_extras(spec):
    """Check the options passed through untouched."""
    if "extras" not in spec:
        spec["extras"] = []
    elif not isinstance(spec["extras"], list) or any(
        not isinstance(option, str) for option in spec["extras"]
    ):
        sys.exit("error: config: 'extras' not valid")


def wee__config_keys(table, name, known):
    """Reject options that do not belong in a table."""
    for key in table:
        if key not in known:
            sys.exit(
                "error: config: '"
                + name
                + "."
                + key
                + "' unknown"
                + wee__near(key, known)
            )


def wee__config_service(conn, svc):
    """Settle whether a service is on and, if so, its host port."""
    if svc not in conn:
        conn[svc] = False
    elif not isinstance(conn[svc], bool):
        sys.exit("error: config: 'conn." + svc + "' not valid")

    if not conn[svc]:
        return

    port = wee__props.conn.ports[svc]
    value = conn["port"].setdefault(svc, port.default)
    if isinstance(value, bool) or not isinstance(value, int):
        sys.exit("error: config: 'conn.port." + svc + "' not valid")

    if not port.minimum <= value <= 65535:
        sys.exit(
            "error: config: 'conn.port."
            + svc
            + "' must be between "
            + str(port.minimum)
            + " and 65535"
        )


def wee__opts_conn_vnc(spec):
    """Settle whether the guest has a display reachable over VNC."""
    wee__config_service(spec["conn"], "vnc")


def wee__opts_conn_ssh(spec):
    """Settle whether a host port is forwarded to the guest's SSH server."""
    wee__config_service(spec["conn"], "ssh")


def wee__opts_conn(spec):
    """Settle how the guest can be reached from the host."""
    if "conn" not in spec:
        spec["conn"] = {}
    elif not isinstance(spec["conn"], dict):
        sys.exit("error: config: 'conn' not valid")

    conn = spec["conn"]
    if "port" not in conn:
        conn["port"] = {}
    elif not isinstance(conn["port"], dict):
        sys.exit("error: config: 'conn.port' not valid")

    wee__config_keys(conn, "conn", tuple(wee__props.conn.ports) + ("port",))
    wee__config_keys(conn["port"], "conn.port", tuple(wee__props.conn.ports))

    wee__opts_conn_vnc(spec)
    wee__opts_conn_ssh(spec)


def wee__config_read(name, mods=None, show=False):
    """Assemble and check the full settings of one guest."""
    data = wee__config_load()
    spec = data.get(name)
    if not spec:
        sys.exit(
            "error: guest: '" + name + "' not found" + wee__near(name, data)
        )

    wee__opts_mods(spec, mods)
    wee__opts_cpu(spec)
    wee__opts_smp(spec)
    wee__opts_mem(spec)
    wee__opts_disk(spec)
    wee__opts_dev(spec)
    wee__opts_bios(spec)
    wee__opts_kernel(spec, show)
    wee__opts_initrd(spec, show)
    wee__opts_append(spec)
    wee__opts_qemu(spec)
    wee__cpu_setup(spec)
    wee__opts_sev(spec)
    wee__opts_sudo(spec)
    wee__opts_extras(spec)
    wee__opts_conn(spec)

    return spec


def wee__launch(name, mods, show=False):
    """Start a guest, or show the command that would start it."""
    spec = wee__config_read(name, mods, show)
    if not spec:
        return 1

    comm = [
        str(spec["qemu"]),
        "-enable-kvm",
        "-machine",
        "q35",
        "-cpu",
        ",".join([spec["cpu"]["model"]] + spec["cpu"]["flags"]),
        "-smp",
        str(spec["smp"]),
        "-m",
        str(spec["mem"]["size"]) + spec["mem"]["unit"],
    ]

    if spec["sudo"]:
        comm.insert(0, "sudo")
    comm.extend(wee__args_bios(spec))
    if "kernel" in spec:
        comm.extend(["-kernel", str(spec["kernel"])])
    if "initrd" in spec:
        comm.extend(["-initrd", str(spec["initrd"])])
    if "append" in spec:
        comm.extend(["-append", spec["append"]])

    comm.extend(wee__args_sev(spec))

    if "extras" in spec:
        comm.extend(spec["extras"])

    comm.extend(
        [
            *wee__args_dev_blk(spec),
            *wee__args_dev_net(spec),
            *wee__args_conn_ssh(spec),
            *wee__args_conn_vnc(spec),
            "-serial",
            "mon:stdio",
        ]
    )

    if show:
        print(shlex.join(comm))
        return 0

    with subprocess.Popen(comm, shell=False) as process:
        return process.wait()


def main() -> int:
    """Parse the command line and carry out the requested command."""
    atexit.register(wee__remote_wipe)

    parser = argparse.ArgumentParser(
        description="Launch basic x86-64 KVM guests."
    )
    subs = parser.add_subparsers(dest="command", metavar="COMMAND")

    subs.add_parser("list", help="list guests")

    mods = subs.add_parser("mods", help="list mods of a guest")
    mods.add_argument("name", metavar="GUEST", type=str, help="guest name")

    subs.add_parser("edit", help="edit guests")

    boot = subs.add_parser("exec", help="start a guest")
    boot.add_argument(
        "--mods", "-m", metavar="LIST", type=str, help="guest mods"
    )
    boot.add_argument(
        "--comm", "-c", action="store_true", help="show command line"
    )
    boot.add_argument("name", metavar="GUEST", type=str, help="guest name")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 0

    if args.command == "list":
        return wee__config_list()

    if args.command == "mods":
        return wee__config_mods(args.name)

    if args.command == "edit":
        return wee__config_edit()

    if args.mods:
        args.mods = [mod.strip() for mod in args.mods.split(",")]

    return wee__launch(args.name, args.mods if args.mods else None, args.comm)


if __name__ == "__main__":
    sys.exit(main())
